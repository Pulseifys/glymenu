{
	"schemaVersion": 1,
	"id": "template-mod",
	"version": "${version}",
	"name": "Gly Custom Menu",
	"description": "Custom dark-purple main menu with rounded translucent buttons and built-in nickname changer.",
	"authors": [
		"glystephan"
	],
	"license": "CC0-1.0",
	"icon": "assets/template-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.TemplateMod"
		],
		"client": [
			"com.example.client.TemplateModClient"
		]
	},
	"mixins": [
		"template-mod.mixins.json",
		{
			"config": "template-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}
